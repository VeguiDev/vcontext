{
  "name": "@app/cli",
  "version": "0.1.1",
  "type": "module",
  "bin": {
    "vcontext": "./dist/src/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "test": "pnpm --dir ../.. exec turbo run build --filter=@app/cli... --filter=@app/deamon... && node -e \"require('node:fs').accessSync('dist/test/cli-vcontext-api.test.js')\" && node --test \"dist/test/*.test.js\"",
    "start": "node dist/src/index.js",
    "lint": "prettier --check src/**/*.ts test/**/*.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/keyring": "1.3.0",
    "@repo/daemon-client": "workspace:^",
    "@repo/vcontext-core": "workspace:^",
    "@repo/vcontext-mcp": "workspace:^",
    "@vcontext/versioning-contract": "workspace:0.1.0",
    "boxen": "^8.0.1",
    "jsonc-parser": "^3.3.1",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "semver": "7.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/semver": "^7.7.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
