{
  "name": "vcontext",
  "version": "0.1.1",
  "type": "module",
  "bin": {
    "vcontext": "./dist/npm/vcontext.mjs"
  },
  "files": [
    "dist/npm/*.mjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "description": "VContext CLI — sync, branch, and manage your VContext projects",
  "keywords": [
    "vcontext",
    "cli",
    "sync",
    "version-control",
    "context",
    "ai",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/VeguiDev/vcontext"
  },
  "homepage": "https://vcontext.dev",
  "bugs": {
    "url": "https://github.com/VeguiDev/vcontext/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "build:npm": "bun ../../scripts/build-npm-package.ts",
    "pack:npm": "npm pack",
    "smoke:npm": "bun ../../scripts/smoke-npm-package.ts",
    "test": "pnpm --dir ../.. exec turbo run build --filter=vcontext... --filter=@app/deamon... && node -e \"require('node:fs').accessSync('dist/test/cli-vcontext-api.test.js')\" && node --test \"dist/test/*.test.js\"",
    "start": "node dist/src/index.js",
    "lint": "prettier --check src/**/*.ts test/**/*.ts",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@hono/node-server": "^1.19.14",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/keyring": "1.3.0",
    "better-sqlite3": "^12.10.0",
    "boxen": "^8.0.1",
    "fast-glob": "^3.3.3",
    "hono": "^4.12.18",
    "jsonc-parser": "^3.3.1",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "semver": "7.8.0",
    "slugify": "^1.6.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/daemon-client": "workspace:^",
    "@repo/vcontext-core": "workspace:^",
    "@repo/vcontext-mcp": "workspace:^",
    "@types/node": "^20.11.17",
    "@types/semver": "^7.7.1",
    "@vcontext/versioning-contract": "workspace:0.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
