---
import InstallCommand from "./InstallCommand.astro";
---

<section class="final-cta" id="get-started" aria-labelledby="cta-title">
  <div class="page-shell final-cta__inner">
    <div>
      <p class="eyebrow">Start here</p>
      <h2 id="cta-title">Give every model the same context.</h2>
    </div>
    <div class="final-cta__action">
      <p>Install locally in one line. Add Cloud later if the project needs to travel.</p>
      <InstallCommand id="footer-install" inverted />
    </div>
  </div>
</section>

