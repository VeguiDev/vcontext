---
const integrations = [
  ["Codex", "MCP", "AI coding agent by OpenAI"],
  ["Claude Desktop", "MCP", "AI assistant by Anthropic"],
  ["OpenCode", "MCP", "Open-source coding agent"],
  ["Terminal", "CLI", "Direct CLI for human workflows"],
  ["Git repositories", "Native", "Automatic hook integration"],
  ["Any MCP client", "Protocol", "Standard protocol, compatible tools"],
];
---

<section class="compatibility" aria-labelledby="compatibility-title">
  <div class="page-shell">
    <div class="compatibility__head">
      <p class="eyebrow">Compatible by default</p>
      <h2 id="compatibility-title">Use the model you want.</h2>
      <p>VContext stays underneath your tools, not in the way of them.</p>
    </div>
    <div class="compatibility__grid">
      {integrations.map(([name, type, description], index) => (
        <div class="integration-card">
          <span>{String(index + 1).padStart(2, "0")}</span>
          <strong>{name}</strong>
          <small>{type}</small>
          <p class="integration-card__desc">{description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

