---
interface Props {
  id?: string;
  inverted?: boolean;
}

const { id = "hero-install", inverted = false } = Astro.props;
---

<div class:list={["install-command", { "install-command--inverted": inverted }]} data-install-command>
  <div class="install-command__topline">
    <div class="install-tabs" role="tablist" aria-label="Installation shell">
      <button type="button" role="tab" aria-selected="true" tabindex="0" aria-controls={`${id}-command`} data-shell="shell">Shell</button>
      <button type="button" role="tab" aria-selected="false" tabindex="-1" aria-controls={`${id}-command`} data-shell="powershell">PowerShell</button>
      <button type="button" role="tab" aria-selected="false" tabindex="-1" aria-controls={`${id}-command`} data-shell="npm">npm</button>
    </div>
    <span class="install-command__hint">One line. That's it.</span>
  </div>
  <div class="install-command__line">
    <span aria-hidden="true">$</span>
    <code id={`${id}-command`} data-command-value>curl -fsSL https://vcontext.dev/install.sh | bash</code>
    <button class="copy-button" type="button" data-copy-button aria-label="Copy install command"><span data-copy-label>Copy</span></button>
  </div>
  <p class="sr-only" aria-live="polite" data-copy-status></p>
</div>

<script>
  const commands = {
    shell: "curl -fsSL https://vcontext.dev/install.sh | bash",
    powershell: "irm https://vcontext.dev/install.ps1 | iex",
    npm: "npm install -g vcontext",
  };

  document.querySelectorAll<HTMLElement>("[data-install-command]").forEach((root) => {
    const output = root.querySelector<HTMLElement>("[data-command-value]");
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-shell]"));
    const copyButton = root.querySelector<HTMLButtonElement>("[data-copy-button]");
    const copyLabel = root.querySelector<HTMLElement>("[data-copy-label]");
    const status = root.querySelector<HTMLElement>("[data-copy-status]");
    const detectedPlatform =
      (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData?.platform ||
      navigator.platform ||
      navigator.userAgent;
    const detectedShell: keyof typeof commands = /windows|win32|win64/i.test(detectedPlatform)
      ? "powershell"
      : "shell";

    const selectShell = (shell: keyof typeof commands) => {
      if (!output || !commands[shell]) return;
      output.textContent = commands[shell];
      tabs.forEach((tab) => {
        const isSelected = tab.dataset.shell === shell;
        tab.setAttribute("aria-selected", String(isSelected));
        tab.tabIndex = isSelected ? 0 : -1;
      });
    };

    const keydownHandler = (event: KeyboardEvent) => {
      const current = tabs.findIndex(
        (tab) => tab.getAttribute("aria-selected") === "true",
      );
      let next = current;

      switch (event.key) {
        case "ArrowRight":
          event.preventDefault();
          next = (current + 1) % tabs.length;
          break;
        case "ArrowLeft":
          event.preventDefault();
          next = (current - 1 + tabs.length) % tabs.length;
          break;
        case "Home":
          event.preventDefault();
          next = 0;
          break;
        case "End":
          event.preventDefault();
          next = tabs.length - 1;
          break;
        default:
          return;
      }

      const shell = tabs[next]?.dataset.shell as keyof typeof commands | undefined;
      if (shell) {
        selectShell(shell);
        tabs[next]?.focus();
      }
    };

    selectShell(detectedShell);
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const shell = tab.dataset.shell as keyof typeof commands;
        selectShell(shell);
        tab.focus();
      });
      tab.addEventListener("keydown", keydownHandler);
    });
    copyButton?.addEventListener("click", async () => {
      const value = output?.textContent?.trim();
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
      } catch {
        const textarea = document.createElement("textarea");
        textarea.value = value;
        textarea.style.position = "fixed";
        textarea.style.opacity = "0";
        document.body.appendChild(textarea);
        textarea.select();
        document.execCommand("copy");
        textarea.remove();
      }
      if (copyLabel) copyLabel.textContent = "Copied";
      if (status) status.textContent = "Install command copied to clipboard.";
      window.setTimeout(() => {
        if (copyLabel) copyLabel.textContent = "Copy";
        if (status) status.textContent = "";
      }, 1800);
    });
  });
</script>
