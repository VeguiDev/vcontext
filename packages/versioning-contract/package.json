  "scripts": {
    "build": "tsc",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "typescript": "^5.8.3"
  }
}
