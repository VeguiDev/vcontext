{
  "name": "@vcontext/versioning-contract",
  "version": "0.1.0",
  "description": "Runtime schemas and canonical wire contract for VContext Sync v1",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
